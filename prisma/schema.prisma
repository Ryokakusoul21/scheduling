generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMINISTRATOR
  REGISTRAR
  HEAD_OF_DEPARTMENT
  FACULTY
  STUDENT
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RoomType {
  LECTURE_ROOM
  COMPUTER_LABORATORY
  SCIENCE_LABORATORY
  CONFERENCE_ROOM
  OTHER
}

enum RoomStatus {
  AVAILABLE
  UNDER_MAINTENANCE
  UNAVAILABLE
}

enum SubjectComponent {
  LECTURE
  LABORATORY
}

enum SubjectCategory {
  MAJOR
  MINOR
}

/// A term within an academic year: semesters for College, quarters for basic education.
enum SemesterType {
  FIRST
  SECOND
  SUMMER
  QUARTER_1
  QUARTER_2
  QUARTER_3
  QUARTER_4
}

enum AcademicLevel {
  ELEMENTARY
  JUNIOR_HIGH
  SENIOR_HIGH
  COLLEGE
}

/// Basic-education grade levels (Kindergarten to Grade 12). College uses YearLevel.
enum GradeLevel {
  KINDER
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
}

enum YearLevel {
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ScheduleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum RequestType {
  NEW_SCHEDULE
  CHANGE_TIME
  CHANGE_ROOM
  CHANGE_FACULTY
  CANCEL_SCHEDULE
  /// A class that needs another department's room or faculty member; approved by that department or the Administrator.
  CROSS_DEPARTMENT
  /// A Head of Department asks the Administrator to change a faculty record.
  FACULTY_CHANGE
  /// A Head of Department asks for a change to a subject owned by another department (faculty, schedule, units, other).
  SUBJECT_CHANGE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  /// Withdrawn by the person who filed it while still pending.
  CANCELLED
}

enum ExaminationType {
  PRELIMINARY
  MIDTERM
  SEMI_FINAL
  FINAL
  SPECIAL
}

/// Calendar activities stored directly; classes, examinations, and bookings come from their own tables.
enum ActivityType {
  SCHOOL_EVENT
  HOLIDAY
  CLASS_SUSPENSION
  /// The window for one examination period; classes still meet, examinations are placed inside it.
  EXAMINATION_WEEK
}

/// Approval state of a submitted activity; only APPROVED ones reach the official calendar.
enum ActivityStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// Lifecycle of one department's semester-wide school-activity proposal.
enum ActivityProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// An Administrator may decide each row while the semester proposal remains under review.
enum ActivityProposalRowStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// Main use of a building, shown as a tag on its card.
enum BuildingPurpose {
  ACADEMIC
  SCIENCE_TECHNOLOGY
  LIBRARY
  ARTS
  SPORTS
  ADMINISTRATION
  MIXED_USE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  AWAITING_APPROVAL
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Higher priority always wins; equal priority is first come, first served. Urgent and Critical may displace classes.
enum BookingPriority {
  REGULAR
  HIGH
  URGENT
  CRITICAL
}

enum UrgentReason {
  ACCREDITATION
  EMERGENCY_MEETING
  ADMINISTRATIVE_DIRECTIVE
  EXAMINATION
  EVENT
  OTHER
}

enum AcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
  ALTERNATIVE_REQUESTED
}

enum UnavailabilityKind {
  FACULTY
  ROOM
}

enum UnavailabilityStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum AdjustmentCause {
  ROOM_BOOKING
  FACULTY_UNAVAILABLE
  ROOM_UNAVAILABLE
  CLASS_SUSPENSION
}

/// What happened to one dated class meeting.
enum AdjustmentKind {
  MOVED
  CANCELLED
  MAKE_UP
  /// Meets online or asynchronously at the same time, without a room.
  ONLINE
}

enum ProposalKind {
  WORKLOAD
  SCHEDULE_REPAIR
}

enum ProposalStatus {
  PENDING
  APPLIED
  REJECTED
  /// Replaced by a newer automatic proposal after the schedule changed.
  SUPERSEDED
}

/// How a workload fix was applied.
enum FixMode {
  AUTOMATIC
  APPROVED
}

/// Scheduling rules; the first four are hard (block saving), the rest are soft (warn, can be overridden).
enum ConstraintKind {
  NO_DOUBLE_BOOKING
  ROOM_CAPACITY
  ROOM_DESIGNATION
  MAX_TEACHING_LOAD
  PREFERRED_TIME
  MAX_CONSECUTIVE
  LUNCH_BREAK
  SUBJECT_TIME_OF_DAY
  MINIMUM_GAP
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  timetableComments   TimetableComment[]    @relation("TimetableCommentAuthor")
  timetablesSubmitted TimetableSubmission[] @relation("TimetableSubmitter")
  timetablesDecided   TimetableSubmission[] @relation("TimetableDecider")
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role
  status       UserStatus @default(ACTIVE)
  image        String?

  // Authentication / security
  emailVerified          DateTime?
  termsAcceptedAt        DateTime?
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  /// Bumped to invalidate every existing session (password reset, "sign out everywhere").
  sessionVersion         Int       @default(0)
  twoFactorEnabled       Boolean   @default(false)
  /// AES-GCM encrypted TOTP secret (see lib/auth/crypto.ts).
  twoFactorSecret        String?
  /// SHA-256 hashes of unused one-time recovery codes; a code is removed when used.
  twoFactorRecoveryCodes String[]  @default([])

  facultyId String?  @unique
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  student Student?

  /// Archived accounts cannot sign in; the record and its history are kept for restore.
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs               AuditLog[]
  notifications           Notification[]
  requestsMade            ScheduleRequest[]          @relation("RequestedBy")
  requestsReviewed        ScheduleRequest[]          @relation("ReviewedBy")
  aiConversations         AIConversation[]
  authTokens              AuthToken[]
  sessions                UserSession[]
  bookings                RoomBooking[]
  subjectChangesRequested SubjectChangeRequest[]     @relation("SubjectChangesRequested")
  departmentAssignments   UserDepartmentAssignment[]
  programAssignments      HeadProgramAssignment[]

  @@index([role])
}

/// Single-use, time-limited tokens for email verification and password reset.
/// Only a SHA-256 hash of the token is stored.
model AuthToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
}

/// Login attempt log used for IP-based rate limiting and auditing.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Department {
  timetableSubmissions TimetableSubmission[]
  id   String @id @default(cuid())
  code String @unique
  name String

  programs              Program[]
  faculty               Faculty[]
  rooms                 Room[]
  activities            Activity[]
  activityProposals     ActivityProposal[]
  sections              Section[]
  subjects              Subject[]
  examBatches           ExamBatch[]
  subjectChangeRequests SubjectChangeRequest[]
  userAssignments       UserDepartmentAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Direct and time-bounded acting department authority for a Head of Department.
model UserDepartmentAssignment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  acting       Boolean    @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([userId, startsAt, endsAt])
}

/// Narrows a Head of Department to specific programs or strands; the department is always taken from the program.
/// No active row means the whole home department.
model HeadProgramAssignment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String
  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  isActing  Boolean   @default(false)
  startDate DateTime  @default(now())
  /// Null keeps the assignment open-ended.
  endDate   DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, programId])
  @@index([programId])
  @@index([userId, startDate, endDate])
}

/// A college course (e.g. BSIT) or a Senior High School strand (e.g. STEM).
model Program {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  level        AcademicLevel @default(COLLEGE)
  sortOrder    Int           @default(0)
  departmentId String?

  department      Department?             @relation(fields: [departmentId], references: [id])
  sections        Section[]
  subjects        Subject[]
  sharedSubjects  Subject[]               @relation("SharedSubjectPrograms")
  semesters       Semester[]
  rooms           Room[]                  @relation("RoomPrograms")
  headAssignments HeadProgramAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  semesters Semester[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A term: a College semester (optionally per program) or a basic-education quarter.
model Semester {
  timetableSubmissions TimetableSubmission[]
  id             String        @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  level          AcademicLevel @default(COLLEGE)
  /// College only: the course this semester belongs to. Null = applies to every course.
  programId      String?
  program        Program?      @relation(fields: [programId], references: [id])
  type           SemesterType
  name           String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean       @default(false)

  sections           Section[]
  schedules          Schedule[]
  examinations       Examination[]
  activityProposals  ActivityProposal[]
  subjectAssignments SubjectAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYearId, level])
}

model Subject {
  id               String          @id @default(cuid())
  code             String          @unique
  name             String
  description      String?
  units            Float
  lectureHours     Float           @default(0)
  labHours         Float           @default(0)
  requiredRoomType RoomType        @default(LECTURE_ROOM)
  level            AcademicLevel   @default(COLLEGE)
  /// College: year level. Basic education: grade level.
  yearLevel        YearLevel?
  gradeLevel       GradeLevel?
  sortOrder        Int             @default(0)
  category         SubjectCategory @default(MAJOR)
  /// Curriculum term; null means the subject can be offered in any term.
  semester         SemesterType?

  programId      String?
  program        Program?  @relation(fields: [programId], references: [id])
  sharedPrograms Program[] @relation("SharedSubjectPrograms")

  /// Owning department (from the program, or the department of a basic-education subject). Null = General Education catalog shared by all.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  schedules         Schedule[]
  classPlaceholders SectionClassPlaceholder[]
  examinations      Examination[]
  changeRequests    SubjectChangeRequest[]
  assignments       SubjectAssignment[]

  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubjectChangeRequest {
  id            String        @id @default(cuid())
  subjectId     String
  subject       Subject       @relation(fields: [subjectId], references: [id])
  departmentId  String?
  department    Department?   @relation(fields: [departmentId], references: [id])
  requestedById String
  requestedBy   User          @relation("SubjectChangesRequested", fields: [requestedById], references: [id])
  message       String
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Section {
  id                String        @id @default(cuid())
  name              String
  level             AcademicLevel @default(COLLEGE)
  /// College sections use yearLevel; basic-education sections use gradeLevel.
  yearLevel         YearLevel?
  gradeLevel        GradeLevel?
  studentCount      Int           @default(0)
  sortOrder         Int           @default(0)
  /// Set for sections created together so generation can be undone safely.
  generationBatchId String?

  /// College course or SHS strand. Null for Elementary / Junior High sections.
  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  /// Owning department; every section belongs to one (basic-education sections to the Basic Education Department).
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id])

  schedules          Schedule[]
  examinations       Examination[]
  students           Student[]
  subjectAssignments SubjectAssignment[]
  classPlaceholders  SectionClassPlaceholder[]

  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, semesterId])
}

/// A curriculum class that is ready to place in the scheduler but has no room, faculty, day, or time yet.
model SectionClassPlaceholder {
  id                  String           @id @default(cuid())
  sectionId           String
  section             Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId           String
  subject             Subject          @relation(fields: [subjectId], references: [id])
  component           SubjectComponent
  /// Faculty and room remembered when the class was moved back to Unscheduled; applied again when it is placed.
  rememberedFacultyId String?
  rememberedRoomId    String?
  preferredFacultyId  String?
  createdAt           DateTime         @default(now())

  @@unique([sectionId, subjectId, component])
  @@index([sectionId])
}

enum AssignmentStatus {
  ACTIVE
  ARCHIVED
}

/// The faculty member who teaches a subject in a term, for one section or (sectionId null) every section.
/// Active rows are unique per subject, section, and term through a partial index in the migration.
model SubjectAssignment {
  id           String           @id @default(cuid())
  subjectId    String
  subject      Subject          @relation(fields: [subjectId], references: [id])
  facultyId    String
  faculty      Faculty          @relation(fields: [facultyId], references: [id])
  sectionId    String?
  section      Section?         @relation(fields: [sectionId], references: [id])
  semesterId   String
  semester     Semester         @relation(fields: [semesterId], references: [id])
  status       AssignmentStatus @default(ACTIVE)
  assignedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([semesterId, status])
  @@index([facultyId])
  @@index([subjectId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

model Faculty {
  id             String          @id @default(cuid())
  employeeId     String          @unique
  fullName       String
  email          String          @unique
  position       String?
  specialization String?
  maxHours       Int             @default(24)
  /// Full-time faculty work every day; part-time faculty work the same hours but keep one day off.
  employmentType EmploymentType  @default(FULL_TIME)
  dayOff         DayOfWeek?
  status         FacultyStatus   @default(ACTIVE)
  /// Academic levels this faculty member teaches.
  teachingLevels AcademicLevel[] @default([COLLEGE])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  user               User?
  availability       FacultyAvailability[]
  schedules          Schedule[]
  proctoring         Examination[]
  unavailability     Unavailability[]
  subjectAssignments SubjectAssignment[]

  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FacultyAvailability {
  id        String    @id @default(cuid())
  facultyId String
  faculty   Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startMin  Int
  endMin    Int

  @@index([facultyId])
}

/// Student profile linked to a STUDENT user; the section determines program and year level.
model Student {
  id            String   @id @default(cuid())
  /// Learner Reference Number or college student number.
  studentNumber String   @unique
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null after the section is deleted; the student picks a new one in the portal.
  sectionId     String?
  section       Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// Facilities
// ---------------------------------------------------------------------------

model Building {
  id             String          @id @default(cuid())
  name           String          @unique
  code           String?
  description    String?
  sortOrder      Int             @default(0)
  /// Where on campus, for example "Main campus, north wing".
  location       String?
  purpose        BuildingPurpose @default(ACADEMIC)
  /// Daily opening and closing time in minutes from midnight; null when not set.
  openingMin     Int?
  closingMin     Int?
  /// Optional photo shown on the building card (resized in the browser before upload).
  photo          Bytes?
  photoType      String?
  photoUpdatedAt DateTime?

  floors Floor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Floor {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String
  /// Floor number for ordering (1 = ground floor).
  number     Int      @default(1)

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, name])
}

model Room {
  id              String      @id @default(cuid())
  roomNumber      String      @unique
  roomName        String
  floorId         String?
  floor           Floor?      @relation(fields: [floorId], references: [id])
  sortOrder       Int         @default(0)
  capacity        Int
  roomType        RoomType
  equipment       String[]
  status          RoomStatus  @default(AVAILABLE)
  /// Owning department; null means a shared room managed by the Administrator.
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  /// Usable by every program and strand; otherwise only by the designated programs.
  isGeneralShared Boolean     @default(true)
  programs        Program[]   @relation("RoomPrograms")

  availability   RoomAvailability[]
  schedules      Schedule[]
  examinations   Examination[]
  bookings       RoomBooking[]
  unavailability Unavailability[]
  activities     Activity[]

  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomAvailability {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startMin  Int
  endMin    Int

  @@index([roomId])
}

model TimeSlot {
  id       String @id @default(cuid())
  label    String
  startMin Int
  endMin   Int

  @@unique([startMin, endMin])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model Schedule {
  id String @id @default(cuid())

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  component SubjectComponent
  dayOfWeek DayOfWeek
  startMin  Int
  endMin    Int

  status       ScheduleStatus @default(DRAFT)
  version      Int            @default(1)
  generatedBy  String? // "AI" or a userId
  score        Float?
  notes        String?
  /// Marked "do not move": an urgent booking cannot displace this class unless the Registrar confirms.
  doNotMove    Boolean        @default(false)
  /// Ownership snapshot used for scope-safe reads and exports.
  departmentId String?
  /// The whole-timetable submission this class was last sent in.
  submissionId String?
  submission   TimetableSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  requests    ScheduleRequest[]
  adjustments ScheduleAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semesterId])
  @@index([facultyId])
  @@index([roomId])
  @@index([sectionId])
  @@index([departmentId])
  @@index([dayOfWeek])
  @@index([submissionId])
}

enum TimetableSubmissionStatus {
  SUBMITTED
  APPROVED
  PUBLISHED
  RETURNED
  REJECTED
  /// Pulled back by the Head of Department before a decision.
  WITHDRAWN
}

enum SubmissionKind {
  CLASS
  EXAMINATION
}

/// A department's full class timetable for one term, sent by the Head of Department and decided by the Super Administrator.
model TimetableSubmission {
  id             String                    @id @default(cuid())
  departmentId   String
  department     Department                @relation(fields: [departmentId], references: [id])
  semesterId     String
  semester       Semester                  @relation(fields: [semesterId], references: [id])
  kind           SubmissionKind            @default(CLASS)
  /// Examination period, for examination submissions only.
  examType       ExaminationType?
  version        Int
  status         TimetableSubmissionStatus @default(SUBMITTED)
  /// When an approved timetable goes live; empty means publish only on request.
  publishAt      DateTime?
  /// Rows as they were when submitted, used to show changes between versions.
  snapshot       Json?
  classCount     Int
  overrideReason String?
  submittedById  String
  submittedBy    User                      @relation("TimetableSubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime                  @default(now())
  decidedById    String?
  decidedBy      User?                     @relation("TimetableDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  /// Reason for returning or rejecting.
  reason         String?
  schedules      Schedule[]
  examinations   Examination[]
  comments       TimetableComment[]

  @@index([departmentId, semesterId])
  @@index([status])
}

/// A reviewer's note on a submitted timetable, optionally about one class or examination.
model TimetableComment {
  id           String              @id @default(cuid())
  submissionId String
  submission   TimetableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// Class or examination id the note is about; empty for the whole timetable.
  rowId        String?
  /// Readable label of that row, kept even if the row changes later.
  rowLabel     String?
  authorId     String
  author       User                @relation("TimetableCommentAuthor", fields: [authorId], references: [id])
  body         String
  createdAt    DateTime            @default(now())

  @@index([submissionId])
}

/// A scheduling rule checked on every save; departmentId null applies to every department.
model SchedulingConstraint {
  id           String         @id @default(cuid())
  kind         ConstraintKind
  name         String
  /// Kind-specific settings validated in lib/scheduler/constraints.ts.
  params       Json           @default("{}")
  enabled      Boolean        @default(true)
  departmentId String?
  createdById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

// ---------------------------------------------------------------------------
// Examinations, calendar, bookings, and dated adjustments
// ---------------------------------------------------------------------------

model Examination {
  id String @id @default(cuid())

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id])
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  proctorId  String
  proctor    Faculty  @relation(fields: [proctorId], references: [id])

  type     ExaminationType @default(MIDTERM)
  date     DateTime        @db.Date
  startMin Int
  endMin   Int
  notes    String?

  /// Same approval flow as class schedules: DRAFT, REVIEW (submitted), PUBLISHED (approved).
  status       ScheduleStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  /// Required when a row is rejected or changes are requested.
  reviewNote   String?

  /// Set when the examination was created by the auto-scheduler, so the whole run can be undone.
  batchId      String?
  batch        ExamBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  /// Ownership snapshot derived from the stored section, never from request input.
  departmentId String?
  submissionId String?
  submission   TimetableSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([batchId])
  @@index([submissionId])
  @@index([departmentId])
}

/// One published run of the examination auto-scheduler.
model ExamBatch {
  id           String          @id @default(cuid())
  semesterId   String
  type         ExaminationType
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id])
  createdById  String
  /// How the schedule was built, shown with the batch and kept for the audit trail.
  explanation  String
  /// Undone runs keep their record; their examinations are removed.
  undoneAt     DateTime?

  examinations Examination[]

  createdAt DateTime @default(now())
}

/// School events, holidays, and class suspensions shown on the calendar.
model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String
  description String?
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  /// Null times mean the activity lasts all day.
  startMin    Int?
  endMin      Int?
  /// Suspensions only: affected sections; empty means every section.
  sectionIds  String[]

  /// Examination weeks only: which examination period this window is for.
  examinationType ExaminationType?

  /// Submitting department; null means institution-wide.
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  /// School level the activity is for; null means every level.
  level        AcademicLevel?
  /// Room used, if any; location holds free text such as "Gymnasium" or "Online".
  roomId       String?
  room         Room?          @relation(fields: [roomId], references: [id])
  location     String?
  participants String?

  status       ActivityStatus @default(APPROVED)
  /// Reason for a rejection or the changes requested.
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  batchId String?          @unique
  batch   AdjustmentBatch? @relation(fields: [batchId], references: [id])

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([status, departmentId])
}

/// A versioned, semester-wide activity table prepared by a Head of Department.
model ActivityProposal {
  id           String                 @id @default(cuid())
  semesterId   String
  semester     Semester               @relation(fields: [semesterId], references: [id])
  departmentId String
  department   Department             @relation(fields: [departmentId], references: [id])
  level        AcademicLevel
  version      Int                    @default(1)
  status       ActivityProposalStatus @default(DRAFT)
  createdById  String
  preparedBy   String?
  designation  String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  submittedAt  DateTime?
  parentId     String?
  parent       ActivityProposal?      @relation("ActivityProposalVersions", fields: [parentId], references: [id])
  revisions    ActivityProposal[]     @relation("ActivityProposalVersions")
  rows         ActivityProposalRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semesterId, departmentId, level, version])
  @@index([status, departmentId])
}

/// One row in the official-style Date and Activity table.
model ActivityProposalRow {
  id         String                    @id @default(cuid())
  proposalId String
  proposal   ActivityProposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  sortOrder  Int                       @default(0)
  title      String
  startDate  DateTime                  @db.Date
  endDate    DateTime                  @db.Date
  startMin   Int?
  endMin     Int?
  location   String?
  level      AcademicLevel?
  category   ActivityType?
  status     ActivityProposalRowStatus @default(PENDING)
  reviewNote String?
  activityId String?                   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proposalId, sortOrder])
}

model RoomBooking {
  id String @id @default(cuid())

  roomId     String
  room       Room   @relation(fields: [roomId], references: [id])
  bookedById String
  bookedBy   User   @relation(fields: [bookedById], references: [id])

  purpose      String
  date         DateTime      @db.Date
  startMin     Int
  endMin       Int
  attendees    Int
  status       BookingStatus @default(CONFIRMED)
  /// Requester's department at creation time; shared rooms remain shared resources.
  departmentId String?

  /// Classes moved to make room for this booking.
  batchId String?          @unique
  batch   AdjustmentBatch? @relation(fields: [batchId], references: [id])

  priority             BookingPriority          @default(REGULAR)
  urgentReason         UrgentReason?
  reasonDetail         String?
  /// Department whose Head of Department must approve an override of its room.
  approvalDepartmentId String?
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  /// The higher-priority booking that took this booking's room.
  displacedById        String?
  displacedBy          RoomBooking?             @relation("BookingDisplacement", fields: [displacedById], references: [id])
  displaced            RoomBooking[]            @relation("BookingDisplacement")
  /// Room held before an override moved this booking, so cancelling the override can move it back.
  previousRoomId       String?
  acknowledgements     BookingAcknowledgement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, date])
  @@index([departmentId])
  @@index([priority, createdAt])
}

/// A faculty member whose class an urgent booking displaced: acknowledged, or asking for another option.
model BookingAcknowledgement {
  id          String                @id @default(cuid())
  bookingId   String
  booking     RoomBooking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  facultyId   String
  status      AcknowledgementStatus @default(PENDING)
  note        String?
  respondedAt DateTime?
  createdAt   DateTime              @default(now())

  @@unique([bookingId, facultyId])
  @@index([facultyId, status])
}

/// A faculty member or room that cannot be used for a date range.
model Unavailability {
  id   String             @id @default(cuid())
  kind UnavailabilityKind

  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  startDate DateTime             @db.Date
  endDate   DateTime             @db.Date
  startMin  Int?
  endMin    Int?
  reason    String
  status    UnavailabilityStatus @default(PENDING)

  reportedById String?
  batchId      String?          @unique
  batch        AdjustmentBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One automatic rescheduling run; undoing it reverts every adjustment inside.
model AdjustmentBatch {
  id           String          @id @default(cuid())
  cause        AdjustmentCause
  summary      String
  createdById  String?
  undoneAt     DateTime?
  createdAt    DateTime        @default(now())
  departmentId String?

  adjustments    ScheduleAdjustment[]
  booking        RoomBooking?
  activity       Activity?
  unavailability Unavailability?
}

/// Overrides one dated meeting of a weekly class (moved, cancelled, or a make-up session).
model ScheduleAdjustment {
  id String @id @default(cuid())

  batchId    String
  batch      AdjustmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   Schedule        @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  kind         AdjustmentKind
  /// The regular meeting date this adjustment replaces.
  date         DateTime       @db.Date
  /// Make-up sessions only: the new date.
  newDate      DateTime?      @db.Date
  /// New values; null keeps the original.
  roomId       String?
  facultyId    String?
  startMin     Int?
  endMin       Int?
  reason       String
  departmentId String?

  createdAt DateTime @default(now())

  @@index([scheduleId, date])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Workload optimization
// ---------------------------------------------------------------------------

/// Suggested faculty reassignments waiting for Head of Department or Administrator approval.
model WorkloadProposal {
  id           String         @id @default(cuid())
  /// Workload reassignments, or timetable changes from Resolve issues on the Scheduler.
  kind         ProposalKind   @default(WORKLOAD)
  semesterId   String
  departmentId String?
  status       ProposalStatus @default(PENDING)
  /// Created by the continuous workload check rather than on request.
  automatic    Boolean        @default(false)
  /// Array of optimizer moves (see lib/workload/optimizer.ts).
  items        Json
  explanation  String
  narrative    String?
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  /// Schedule repair: when the proposal was generated; applying refuses if its classes changed since.
  generatedAt  DateTime?
  /// Schedule repair: the options the resolver ran with.
  options      Json?
  undoneAt     DateTime?
  undoneById   String?
  /// Reason given when the proposal was rejected.
  reviewNote   String?
  /// Bumped by every review so two approvals of the same proposal cannot both apply.
  version      Int            @default(1)
  /// Fingerprint of who teaches what for the faculty involved; a change supersedes the proposal.
  basis        String?
  createdAt    DateTime       @default(now())

  rows WorkloadProposalItem[]

  @@index([kind, status])
}

enum ProposalItemStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

/// One proposed reassignment inside a workload proposal, approved or rejected on its own.
model WorkloadProposalItem {
  id               String             @id @default(cuid())
  proposalId       String
  proposal         WorkloadProposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// Assignment key from the optimizer (section|subject|faculty, or plan|assignmentId for unscheduled subjects).
  key              String
  /// The optimizer move, including labels, meetings, and loads when proposed.
  move             Json
  fromFacultyId    String
  toFacultyId      String
  fromDepartmentId String?
  toDepartmentId   String?
  status           ProposalItemStatus @default(PENDING)
  /// Each side's Head of Department (or the Administrator); a same-department row needs only the first.
  fromApprovedById String?
  toApprovedById   String?
  reviewedById     String?
  reviewedAt       DateTime?
  /// True when a Head of Department picked a different receiver than the optimizer.
  edited           Boolean            @default(false)

  @@index([proposalId])
}

/// One applied workload reassignment with the loads before and after; undoing restores the original faculty.
model WorkloadFix {
  id            String    @id @default(cuid())
  mode          FixMode
  proposalId    String?
  trigger       String
  assignmentKey String
  scheduleIds   String[]
  label         String
  fromFacultyId String
  toFacultyId   String
  measure       String
  amount        Float
  fromBefore    Float
  fromAfter     Float
  toBefore      Float
  toAfter       Float
  reason        String
  appliedById   String?
  appliedAt     DateTime  @default(now())
  undoneAt      DateTime?
  undoneById    String?
  departmentId  String?

  @@index([appliedAt])
  @@index([departmentId])
}

model ScheduleRequest {
  id     String        @id @default(cuid())
  type   RequestType
  status RequestStatus @default(PENDING)

  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])

  requestedById String
  requestedBy   User   @relation("RequestedBy", fields: [requestedById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ReviewedBy", fields: [reviewedById], references: [id])

  details            Json
  reason             String?
  reviewNote         String?
  /// Cross-department requests: the department whose Head of Department may approve (the Administrator always may).
  targetDepartmentId String?
  /// Owning/requesting department, derived from the stored schedule or requester.
  departmentId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([departmentId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         NotificationType @default(INFO)
  title        String
  message      String
  isRead       Boolean          @default(false)
  link         String?
  departmentId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([departmentId])
}

/// One row per sign-in so the profile can list devices and revoke them individually.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// User.sessionVersion at sign-in; rows from before a "sign out everywhere" or password change are stale.
  version      Int
  device       String
  ipAddress    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action       String
  entity       String
  entityId     String?
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  role         String?
  departmentId String?
  reason       String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([departmentId])
}

model AIConversation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String?
  messages AIMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String
  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// One row per calendar day of key dashboard counts, used to compute real
/// day-over-day trend indicators (never fabricated percentages).
model DailyStat {
  id            String   @id @default(cuid())
  date          DateTime @unique @db.Date
  totalSections Int      @default(0)
  totalFaculty  Int
  totalSubjects Int
  totalRooms    Int
  openConflicts Int
  createdAt     DateTime @default(now())
}
