generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMINISTRATOR
  REGISTRAR
  SCHEDULER
  FACULTY
  STUDENT
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RoomType {
  LECTURE_ROOM
  COMPUTER_LABORATORY
  SCIENCE_LABORATORY
  CONFERENCE_ROOM
  OTHER
}

enum RoomStatus {
  AVAILABLE
  UNDER_MAINTENANCE
  UNAVAILABLE
}

enum SubjectComponent {
  LECTURE
  LABORATORY
}

/// A term within an academic year: semesters for College, quarters for basic education.
enum SemesterType {
  FIRST
  SECOND
  SUMMER
  QUARTER_1
  QUARTER_2
  QUARTER_3
  QUARTER_4
}

enum AcademicLevel {
  ELEMENTARY
  JUNIOR_HIGH
  SENIOR_HIGH
  COLLEGE
}

/// Basic-education grade levels (Kindergarten to Grade 12). College uses YearLevel.
enum GradeLevel {
  KINDER
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
}

enum YearLevel {
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}


enum ScheduleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum RequestType {
  NEW_SCHEDULE
  CHANGE_TIME
  CHANGE_ROOM
  CHANGE_FACULTY
  CANCEL_SCHEDULE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}




enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role
  status       UserStatus @default(ACTIVE)
  image        String?

  // Authentication / security
  emailVerified       DateTime?
  termsAcceptedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  /// Bumped to invalidate every existing session (password reset, "sign out everywhere").
  sessionVersion      Int       @default(0)
  twoFactorEnabled    Boolean   @default(false)
  /// AES-GCM encrypted TOTP secret (see lib/auth/crypto.ts).
  twoFactorSecret     String?

  facultyId String?  @unique
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs        AuditLog[]
  notifications    Notification[]
  requestsMade     ScheduleRequest[] @relation("RequestedBy")
  requestsReviewed ScheduleRequest[] @relation("ReviewedBy")
  aiConversations  AIConversation[]
  authTokens       AuthToken[]

  @@index([role])
}

/// Single-use, time-limited tokens for email verification and password reset.
/// Only a SHA-256 hash of the token is stored.
model AuthToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
}

/// Login attempt log used for IP-based rate limiting and auditing.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Department {
  id   String @id @default(cuid())
  code String @unique
  name String

  programs Program[]
  faculty  Faculty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A college course (e.g. BSIT) or a Senior High School strand (e.g. STEM).
model Program {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  level        AcademicLevel @default(COLLEGE)
  sortOrder    Int           @default(0)
  departmentId String?

  department Department? @relation(fields: [departmentId], references: [id])
  sections   Section[]
  subjects   Subject[]
  semesters  Semester[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  semesters Semester[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A term: a College semester (optionally per program) or a basic-education quarter.
model Semester {
  id             String        @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  level          AcademicLevel @default(COLLEGE)
  /// College only: the course this semester belongs to. Null = applies to every course.
  programId      String?
  program        Program?      @relation(fields: [programId], references: [id])
  type           SemesterType
  name           String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(false)

  sections  Section[]
  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYearId, level])
}

model Subject {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String
  description      String?
  units            Float
  lectureHours     Float     @default(0)
  labHours         Float     @default(0)
  requiredRoomType RoomType  @default(LECTURE_ROOM)
  level            AcademicLevel @default(COLLEGE)
  /// College: year level. Basic education: grade level.
  yearLevel        YearLevel?
  gradeLevel       GradeLevel?
  sortOrder        Int           @default(0)

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Section {
  id           String        @id @default(cuid())
  name         String
  level        AcademicLevel @default(COLLEGE)
  /// College sections use yearLevel; basic-education sections use gradeLevel.
  yearLevel    YearLevel?
  gradeLevel   GradeLevel?
  studentCount Int           @default(0)
  sortOrder    Int           @default(0)

  /// College course or SHS strand. Null for Elementary / Junior High sections.
  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id])

  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, semesterId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Faculty {
  id             String        @id @default(cuid())
  employeeId     String        @unique
  fullName       String
  email          String        @unique
  position       String?
  specialization String?
  maxHours       Int           @default(24)
  status         FacultyStatus @default(ACTIVE)
  /// Academic levels this faculty member teaches.
  teachingLevels AcademicLevel[] @default([COLLEGE])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  user         User?
  availability FacultyAvailability[]
  schedules    Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FacultyAvailability {
  id        String    @id @default(cuid())
  facultyId String
  faculty   Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startMin  Int
  endMin    Int

  @@index([facultyId])
}


// ---------------------------------------------------------------------------
// Facilities
// ---------------------------------------------------------------------------

model Building {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String?
  description String?
  sortOrder   Int     @default(0)

  floors Floor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Floor {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String
  /// Floor number for ordering (1 = ground floor).
  number     Int      @default(1)

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, name])
}

model Room {
  id         String     @id @default(cuid())
  roomNumber String     @unique
  roomName   String
  floorId    String?
  floor      Floor?     @relation(fields: [floorId], references: [id])
  sortOrder  Int        @default(0)
  capacity   Int
  roomType   RoomType
  equipment  String[]
  status     RoomStatus @default(AVAILABLE)

  availability RoomAvailability[]
  schedules    Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomAvailability {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startMin  Int
  endMin    Int

  @@index([roomId])
}

model TimeSlot {
  id       String @id @default(cuid())
  label    String
  startMin Int
  endMin   Int

  @@unique([startMin, endMin])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model Schedule {
  id String @id @default(cuid())

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  component SubjectComponent
  dayOfWeek DayOfWeek
  startMin  Int
  endMin    Int

  status      ScheduleStatus @default(DRAFT)
  version     Int            @default(1)
  generatedBy String? // "AI" or a userId
  score       Float?
  notes       String?

  requests ScheduleRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semesterId])
  @@index([facultyId])
  @@index([roomId])
  @@index([sectionId])
  @@index([dayOfWeek])
}


model ScheduleRequest {
  id     String        @id @default(cuid())
  type   RequestType
  status RequestStatus @default(PENDING)

  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])

  requestedById String
  requestedBy   User   @relation("RequestedBy", fields: [requestedById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ReviewedBy", fields: [reviewedById], references: [id])

  details    Json
  reason     String?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType @default(INFO)
  title   String
  message String
  isRead  Boolean          @default(false)
  link    String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
}


model AIConversation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String?
  messages AIMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String
  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// One row per calendar day of key dashboard counts, used to compute real
/// day-over-day trend indicators (never fabricated percentages).
model DailyStat {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  totalSections  Int      @default(0)
  totalFaculty   Int
  totalSubjects  Int
  totalRooms     Int
  openConflicts  Int
  createdAt      DateTime @default(now())
}
