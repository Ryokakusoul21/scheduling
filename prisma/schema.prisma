generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMINISTRATOR
  HEAD_OF_DEPARTMENT
  FACULTY
  STUDENT
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RoomType {
  LECTURE_ROOM
  COMPUTER_LABORATORY
  SCIENCE_LABORATORY
  CONFERENCE_ROOM
  OTHER
}

enum RoomStatus {
  AVAILABLE
  UNDER_MAINTENANCE
  UNAVAILABLE
}

enum SubjectComponent {
  LECTURE
  LABORATORY
}

/// A term within an academic year: semesters for College, quarters for basic education.
enum SemesterType {
  FIRST
  SECOND
  SUMMER
  QUARTER_1
  QUARTER_2
  QUARTER_3
  QUARTER_4
}

enum AcademicLevel {
  ELEMENTARY
  JUNIOR_HIGH
  SENIOR_HIGH
  COLLEGE
}

/// Basic-education grade levels (Kindergarten to Grade 12). College uses YearLevel.
enum GradeLevel {
  KINDER
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
}

enum YearLevel {
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}


enum ScheduleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum RequestType {
  NEW_SCHEDULE
  CHANGE_TIME
  CHANGE_ROOM
  CHANGE_FACULTY
  CANCEL_SCHEDULE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}




enum ExaminationType {
  PRELIMINARY
  MIDTERM
  FINAL
  SPECIAL
}

/// Calendar activities stored directly; classes, examinations, and bookings come from their own tables.
enum ActivityType {
  SCHOOL_EVENT
  HOLIDAY
  CLASS_SUSPENSION
}

/// Approval state of a submitted activity; only APPROVED ones reach the official calendar.
enum ActivityStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum UnavailabilityKind {
  FACULTY
  ROOM
}

enum UnavailabilityStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum AdjustmentCause {
  ROOM_BOOKING
  FACULTY_UNAVAILABLE
  ROOM_UNAVAILABLE
  CLASS_SUSPENSION
}

/// What happened to one dated class meeting.
enum AdjustmentKind {
  MOVED
  CANCELLED
  MAKE_UP
}

enum ProposalStatus {
  PENDING
  APPLIED
  REJECTED
  /// Replaced by a newer automatic proposal after the schedule changed.
  SUPERSEDED
}

/// How a workload fix was applied.
enum FixMode {
  AUTOMATIC
  APPROVED
}

/// Scheduling rules; the first four are hard (block saving), the rest are soft (warn, can be overridden).
enum ConstraintKind {
  NO_DOUBLE_BOOKING
  ROOM_CAPACITY
  ROOM_DESIGNATION
  MAX_TEACHING_LOAD
  PREFERRED_TIME
  MAX_CONSECUTIVE
  LUNCH_BREAK
  SUBJECT_TIME_OF_DAY
  MINIMUM_GAP
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role
  status       UserStatus @default(ACTIVE)
  image        String?

  // Authentication / security
  emailVerified       DateTime?
  termsAcceptedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  /// Bumped to invalidate every existing session (password reset, "sign out everywhere").
  sessionVersion      Int       @default(0)
  twoFactorEnabled    Boolean   @default(false)
  /// AES-GCM encrypted TOTP secret (see lib/auth/crypto.ts).
  twoFactorSecret     String?

  facultyId String?  @unique
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  student Student?

  /// Archived accounts cannot sign in; the record and its history are kept for restore.
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs        AuditLog[]
  notifications    Notification[]
  requestsMade     ScheduleRequest[] @relation("RequestedBy")
  requestsReviewed ScheduleRequest[] @relation("ReviewedBy")
  aiConversations  AIConversation[]
  authTokens       AuthToken[]
  bookings         RoomBooking[]

  @@index([role])
}

/// Single-use, time-limited tokens for email verification and password reset.
/// Only a SHA-256 hash of the token is stored.
model AuthToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
}

/// Login attempt log used for IP-based rate limiting and auditing.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Department {
  id   String @id @default(cuid())
  code String @unique
  name String

  programs   Program[]
  faculty    Faculty[]
  rooms      Room[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A college course (e.g. BSIT) or a Senior High School strand (e.g. STEM).
model Program {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  level        AcademicLevel @default(COLLEGE)
  sortOrder    Int           @default(0)
  departmentId String?

  department Department? @relation(fields: [departmentId], references: [id])
  sections   Section[]
  subjects   Subject[]
  semesters  Semester[]
  rooms      Room[]     @relation("RoomPrograms")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  semesters Semester[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A term: a College semester (optionally per program) or a basic-education quarter.
model Semester {
  id             String        @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  level          AcademicLevel @default(COLLEGE)
  /// College only: the course this semester belongs to. Null = applies to every course.
  programId      String?
  program        Program?      @relation(fields: [programId], references: [id])
  type           SemesterType
  name           String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(false)

  sections     Section[]
  schedules    Schedule[]
  examinations Examination[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYearId, level])
}

model Subject {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String
  description      String?
  units            Float
  lectureHours     Float     @default(0)
  labHours         Float     @default(0)
  requiredRoomType RoomType  @default(LECTURE_ROOM)
  level            AcademicLevel @default(COLLEGE)
  /// College: year level. Basic education: grade level.
  yearLevel        YearLevel?
  gradeLevel       GradeLevel?
  sortOrder        Int           @default(0)

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  schedules    Schedule[]
  examinations Examination[]

  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Section {
  id           String        @id @default(cuid())
  name         String
  level        AcademicLevel @default(COLLEGE)
  /// College sections use yearLevel; basic-education sections use gradeLevel.
  yearLevel    YearLevel?
  gradeLevel   GradeLevel?
  studentCount Int           @default(0)
  sortOrder    Int           @default(0)

  /// College course or SHS strand. Null for Elementary / Junior High sections.
  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id])

  schedules    Schedule[]
  examinations Examination[]
  students     Student[]

  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, semesterId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Faculty {
  id             String        @id @default(cuid())
  employeeId     String        @unique
  fullName       String
  email          String        @unique
  position       String?
  specialization String?
  maxHours       Int           @default(24)
  status         FacultyStatus @default(ACTIVE)
  /// Academic levels this faculty member teaches.
  teachingLevels AcademicLevel[] @default([COLLEGE])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  user           User?
  availability   FacultyAvailability[]
  schedules      Schedule[]
  proctoring     Examination[]
  unavailability Unavailability[]

  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FacultyAvailability {
  id        String    @id @default(cuid())
  facultyId String
  faculty   Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startMin  Int
  endMin    Int

  @@index([facultyId])
}


/// Student profile linked to a STUDENT user; the section determines program and year level.
model Student {
  id            String  @id @default(cuid())
  /// Learner Reference Number or college student number.
  studentNumber String  @unique
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null after the section is deleted; the student picks a new one in the portal.
  sectionId     String?
  section       Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// Facilities
// ---------------------------------------------------------------------------

model Building {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String?
  description String?
  sortOrder   Int     @default(0)

  floors Floor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Floor {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String
  /// Floor number for ordering (1 = ground floor).
  number     Int      @default(1)

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, name])
}

model Room {
  id         String     @id @default(cuid())
  roomNumber String     @unique
  roomName   String
  floorId    String?
  floor      Floor?     @relation(fields: [floorId], references: [id])
  sortOrder  Int        @default(0)
  capacity   Int
  roomType   RoomType
  equipment  String[]
  status     RoomStatus @default(AVAILABLE)
  /// Owning department; null means a shared room managed by the Administrator.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  /// Usable by every program and strand; otherwise only by the designated programs.
  isGeneralShared Boolean   @default(true)
  programs        Program[] @relation("RoomPrograms")

  availability   RoomAvailability[]
  schedules      Schedule[]
  examinations   Examination[]
  bookings       RoomBooking[]
  unavailability Unavailability[]
  activities     Activity[]

  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomAvailability {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startMin  Int
  endMin    Int

  @@index([roomId])
}

model TimeSlot {
  id       String @id @default(cuid())
  label    String
  startMin Int
  endMin   Int

  @@unique([startMin, endMin])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model Schedule {
  id String @id @default(cuid())

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  component SubjectComponent
  dayOfWeek DayOfWeek
  startMin  Int
  endMin    Int

  status      ScheduleStatus @default(DRAFT)
  version     Int            @default(1)
  generatedBy String? // "AI" or a userId
  score       Float?
  notes       String?

  requests    ScheduleRequest[]
  adjustments ScheduleAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semesterId])
  @@index([facultyId])
  @@index([roomId])
  @@index([sectionId])
  @@index([dayOfWeek])
}

/// A scheduling rule checked on every save; departmentId null applies to every department.
model SchedulingConstraint {
  id           String         @id @default(cuid())
  kind         ConstraintKind
  name         String
  /// Kind-specific settings validated in lib/scheduler/constraints.ts.
  params       Json           @default("{}")
  enabled      Boolean        @default(true)
  departmentId String?
  createdById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

// ---------------------------------------------------------------------------
// Examinations, calendar, bookings, and dated adjustments
// ---------------------------------------------------------------------------

model Examination {
  id String @id @default(cuid())

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id])
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  proctorId  String
  proctor    Faculty  @relation(fields: [proctorId], references: [id])

  type     ExaminationType @default(MIDTERM)
  date     DateTime        @db.Date
  startMin Int
  endMin   Int
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// School events, holidays, and class suspensions shown on the calendar.
model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String
  description String?
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  /// Null times mean the activity lasts all day.
  startMin    Int?
  endMin      Int?
  /// Suspensions only: affected sections; empty means every section.
  sectionIds  String[]

  /// Submitting department; null means institution-wide.
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  /// School level the activity is for; null means every level.
  level        AcademicLevel?
  /// Room used, if any; location holds free text such as "Gymnasium" or "Online".
  roomId       String?
  room         Room?          @relation(fields: [roomId], references: [id])
  location     String?
  participants String?

  status       ActivityStatus @default(APPROVED)
  /// Reason for a rejection or the changes requested.
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  batchId String?          @unique
  batch   AdjustmentBatch? @relation(fields: [batchId], references: [id])

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([status, departmentId])
}

model RoomBooking {
  id String @id @default(cuid())

  roomId     String
  room       Room   @relation(fields: [roomId], references: [id])
  bookedById String
  bookedBy   User   @relation(fields: [bookedById], references: [id])

  purpose   String
  date      DateTime      @db.Date
  startMin  Int
  endMin    Int
  attendees Int
  status    BookingStatus @default(CONFIRMED)

  /// Classes moved to make room for this booking.
  batchId String?          @unique
  batch   AdjustmentBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, date])
}

/// A faculty member or room that cannot be used for a date range.
model Unavailability {
  id   String             @id @default(cuid())
  kind UnavailabilityKind

  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  startDate DateTime             @db.Date
  endDate   DateTime             @db.Date
  startMin  Int?
  endMin    Int?
  reason    String
  status    UnavailabilityStatus @default(PENDING)

  reportedById String?
  batchId      String?          @unique
  batch        AdjustmentBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One automatic rescheduling run; undoing it reverts every adjustment inside.
model AdjustmentBatch {
  id          String          @id @default(cuid())
  cause       AdjustmentCause
  summary     String
  createdById String?
  undoneAt    DateTime?
  createdAt   DateTime        @default(now())

  adjustments    ScheduleAdjustment[]
  booking        RoomBooking?
  activity       Activity?
  unavailability Unavailability?
}

/// Overrides one dated meeting of a weekly class (moved, cancelled, or a make-up session).
model ScheduleAdjustment {
  id String @id @default(cuid())

  batchId    String
  batch      AdjustmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   Schedule        @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  kind      AdjustmentKind
  /// The regular meeting date this adjustment replaces.
  date      DateTime       @db.Date
  /// Make-up sessions only: the new date.
  newDate   DateTime?      @db.Date
  /// New values; null keeps the original.
  roomId    String?
  facultyId String?
  startMin  Int?
  endMin    Int?
  reason    String

  createdAt DateTime @default(now())

  @@index([scheduleId, date])
}

// ---------------------------------------------------------------------------
// Workload optimization and enrollment forecasting
// ---------------------------------------------------------------------------

/// Suggested faculty reassignments waiting for Head of Department or Administrator approval.
model WorkloadProposal {
  id           String         @id @default(cuid())
  semesterId   String
  departmentId String?
  status       ProposalStatus @default(PENDING)
  /// Created by the continuous workload check rather than on request.
  automatic    Boolean        @default(false)
  /// Array of optimizer moves (see lib/workload/optimizer.ts).
  items        Json
  explanation  String
  narrative    String?
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
}

/// One applied workload reassignment with the loads before and after; undoing restores the original faculty.
model WorkloadFix {
  id            String   @id @default(cuid())
  mode          FixMode
  proposalId    String?
  trigger       String
  assignmentKey String
  scheduleIds   String[]
  label         String
  fromFacultyId String
  toFacultyId   String
  measure       String
  amount        Float
  fromBefore    Float
  fromAfter     Float
  toBefore      Float
  toAfter       Float
  reason        String
  appliedById   String?
  appliedAt     DateTime  @default(now())
  undoneAt      DateTime?
  undoneById    String?

  @@index([appliedAt])
}

/// Historical enrollment per program (or per level when there is no program) and term.
model EnrollmentRecord {
  id           String        @id @default(cuid())
  level        AcademicLevel
  programId    String?
  academicYear String
  termType     SemesterType
  enrolled     Int

  @@index([level, programId])
}

model ScheduleRequest {
  id     String        @id @default(cuid())
  type   RequestType
  status RequestStatus @default(PENDING)

  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])

  requestedById String
  requestedBy   User   @relation("RequestedBy", fields: [requestedById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ReviewedBy", fields: [reviewedById], references: [id])

  details    Json
  reason     String?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType @default(INFO)
  title   String
  message String
  isRead  Boolean          @default(false)
  link    String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
}


model AIConversation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String?
  messages AIMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String
  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// One row per calendar day of key dashboard counts, used to compute real
/// day-over-day trend indicators (never fabricated percentages).
model DailyStat {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  totalSections  Int      @default(0)
  totalFaculty   Int
  totalSubjects  Int
  totalRooms     Int
  openConflicts  Int
  createdAt      DateTime @default(now())
}
